---
import type { BlogPost } from '../../util/blog'
import { formatDate } from '../../util/blog'
import { pathWithBase } from '../../util/links'

interface Props {
  posts: BlogPost[]
}

const { posts } = Astro.props
---

{
  posts.length > 0 && (
    <section id="blog" class="blog-section">
      <div class="sec-head">
        <h2>From the blog</h2>
        <a class="more" href={pathWithBase('/blog/')}>
          All posts →
        </a>
      </div>
      <div class="row">
        {posts.map((post, i) => (
          <article class={i === 0 ? 'lead' : ''}>
            <a href={pathWithBase(`/blog/${post.id}/`)}>
              <span class="kicker">{post.data.tags[0] ?? 'Blog'}</span>
              <h3>{post.data.title}</h3>
              <p>{post.data.description}</p>
              <span class="meta">
                {formatDate(post.data.date)}
                {post.data.readingTime && ` · ${post.data.readingTime}`}
              </span>
            </a>
          </article>
        ))}
      </div>
    </section>
  )
}

<style>
  .blog-section {
    padding: 4.25rem 0;
    border-top: 1px solid #262626;
  }

  :global([data-theme='light']) .blog-section {
    border-top-color: rgba(0, 0, 0, 0.1);
  }

  .sec-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
  }

  h2 {
    font-family: 'Figtree', sans-serif;
    font-size: 2.625rem;
    letter-spacing: -0.02em;
    font-weight: 600;
    color: var(--sl-color-white);
    margin: 0;
  }

  .more {
    font-family: 'Figtree', sans-serif;
    font-size: 0.875rem;
    color: #00cc5f;
    font-weight: 600;
    text-decoration: none;
  }

  .row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2.25rem;
    margin-top: 2.5rem;
  }

  /* Typographic cards: category-colored top rule, headline as the visual object.
     The newest post's rule is green; the rest stay neutral. */
  article {
    border-top: 2px solid #333;
  }

  article.lead {
    border-top-color: #00cc5f;
  }

  :global([data-theme='light']) article {
    border-top-color: rgba(0, 0, 0, 0.15);
  }

  :global([data-theme='light']) article.lead {
    border-top-color: #00cc5f;
  }

  article a {
    text-decoration: none;
    display: block;
    padding-top: 1.125rem;
  }

  .kicker {
    font-family: 'Figtree', sans-serif;
    font-size: 0.75rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #7a7a7a;
    font-weight: 700;
  }

  article.lead .kicker {
    color: #00cc5f;
  }

  h3 {
    font-family: 'Figtree', sans-serif;
    font-size: 1.4375rem;
    line-height: 1.25;
    letter-spacing: -0.01em;
    margin: 0.625rem 0 0.5rem;
    font-weight: 600;
    color: var(--sl-color-white);
  }

  article a:hover h3 {
    color: #00ff77;
  }

  article p {
    color: var(--sl-color-gray-3);
    font-size: 0.875rem;
    font-family: 'Figtree', sans-serif;
    margin: 0;
  }

  .meta {
    display: block;
    font-family: 'Figtree', sans-serif;
    font-size: 0.75rem;
    color: #5a5a5a;
    margin-top: 0.75rem;
  }

  :global([data-theme='light']) .meta {
    color: var(--sl-color-gray-3);
  }

  @media (max-width: 900px) {
    .row {
      grid-template-columns: 1fr;
      gap: 1.25rem;
      margin-top: 1.75rem;
    }

    /* Compact stacked rows on mobile: tighter type, clamped description
       so three posts don't dominate the scroll */
    article a {
      padding-top: 0.875rem;
    }

    h3 {
      font-size: 1.1875rem;
    }

    article p {
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }

    h2 {
      font-size: 2rem;
    }
  }
</style>
